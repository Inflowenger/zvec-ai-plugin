# Platform identity — minted by Infra when the plugin is defined in a space.
# Copy to .env.inflow and fill in. No zvec configuration lives here: the data
# directory is entered per-account in the node's settings dialog and arrives
# with every call as body.settings.

PLUGIN_ID=aa-bbb-ccc-dddd
INFRA_CRED=base64-of-the-nats-.creds-blob
INFRA_URL=localhost:4222

# Optional: raise the NATS request/reply deadline (seconds). Index building and
# large upserts are slower than a network round-trip, so the plugin asks for 60s
# by default; this overrides it at deploy time.
# REQ_TIMEOUT=60

# Where the zvec C-API shared library lives. Needed unless libzvec_c_api.so sits
# next to the binary, in ./lib/<goos>_<goarch>/, or on the system search path.
# ZVEC_LIBRARY_PATH=/opt/zvec/lib/linux_amd64/libzvec_c_api.so

# Optional global engine tuning. These configure the zvec library itself, which
# is initialised once per process, so they cannot be set per settings profile.
# ZVEC_MEMORY_LIMIT_MB=4096
# ZVEC_QUERY_THREADS=4
# ZVEC_OPTIMIZE_THREADS=2
# ZVEC_LOG_LEVEL=warn          # debug | info | warn | error | fatal
